                "b": "cancellation",
                "o": "text:equal"
              },
              {
                "a": "{{4.information.is_automated}}",
                "b": false,
                "o": "boolean:equal"
              },
              {
                "a": "{{1.fromEmail}}",
                "o": "exist"
              },
              {
                "a": "{{1.fromEmail}}",
                "b": "",
                "o": "text:notequal"
              },
              {
                "a": "{{1.fromEmail}}",
                "b": "<OWNER_MAILBOX>",
                "o": "text:notequal"
              },
              {
